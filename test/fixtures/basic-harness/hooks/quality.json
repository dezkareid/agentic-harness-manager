{
  "hooks": {
    "PostToolUse": [
      { "matcher": "Edit|Write", "hooks": [{ "type": "command", "command": "pnpm lint:fix" }] }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "./scripts/guard.sh" },
          { "type": "prompt", "prompt": "Is this command safe?" }
        ]
      }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "./scripts/log-prompt.sh" }] }
    ],
    "Notification": [
      { "hooks": [{ "type": "command", "command": "say 'Claude needs you'" }] }
    ]
  }
}
